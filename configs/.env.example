# Copy to configs/.env and fill in. configs/ is git-ignored; never commit it.

# Bot token from the Discord Developer Portal (secret)
DISCORD_TOKEN=

# PostgreSQL container credentials (used by the db service)
POSTGRES_USER=sidequest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sidequest

# Database URL used by the bot. Host "db" is the compose service name.
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://sidequest:change-me@db:5432/sidequest

# IANA timezone name, used for users who never set a timezone
DEFAULT_TIMEZONE=UTC

# Log level: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Command sync.
# SYNC_GLOBAL=true (production): commands are registered globally (all servers, DMs,
#   user installs). Servers in SYNC_GUILD_IDS get their server-only commands deleted, which
#   cleans up after a bot ran with SYNC_GLOBAL=false.
# SYNC_GLOBAL=false (dev bot): commands only in the servers in SYNC_GUILD_IDS (instant),
#   global commands are cleared, so DMs have none. Needs at least one ID.
# SYNC_GUILD_IDS: comma-separated server IDs.
SYNC_GLOBAL=true
# SYNC_GUILD_IDS=123456789012345678,234567890123456789

# Run "alembic upgrade head" on start
RUN_MIGRATIONS=true

# COMMIT, BRANCH and DEPLOY_TIME are written by update.sh to configs/git.env.
# Do not set them here.
